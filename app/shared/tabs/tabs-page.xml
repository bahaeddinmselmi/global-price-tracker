<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <ActionBar title="Little Explorer" class="nav-header">
        <NavigationButton visibility="collapse" />
    </ActionBar>

    <BottomNavigation selectedIndex="{{ selectedTabIndex }}" class="bottom-nav">
        <TabStrip>
            <TabStripItem class="{{ selectedTabIndex === 0 ? 'bottom-nav-item-active' : 'bottom-nav-item' }}">
                <Label text="Unité" />
                <Image src="~/assets/images/icons/units.png" />
            </TabStripItem>
            <TabStripItem class="{{ selectedTabIndex === 1 ? 'bottom-nav-item-active' : 'bottom-nav-item' }}">
                <Label text="Jeux" />
                <Image src="~/assets/images/icons/games.png" />
            </TabStripItem>
            <TabStripItem class="{{ selectedTabIndex === 2 ? 'bottom-nav-item-active' : 'bottom-nav-item' }}">
                <Label text="Histoires" />
                <Image src="~/assets/images/icons/stories.png" />
            </TabStripItem>
            <TabStripItem class="{{ selectedTabIndex === 3 ? 'bottom-nav-item-active' : 'bottom-nav-item' }}">
                <Label text="Vidéos" />
                <Image src="~/assets/images/icons/videos.png" />
            </TabStripItem>
            <TabStripItem class="{{ selectedTabIndex === 4 ? 'bottom-nav-item-active' : 'bottom-nav-item' }}">
                <Label text="Paramètres" />
                <Image src="~/assets/images/icons/settings.png" />
            </TabStripItem>
        </TabStrip>

        <TabContentItem>
            <Frame defaultPage="~/units/units-page" />
        </TabContentItem>
        <TabContentItem>
            <Frame defaultPage="~/games/games-page" />
        </TabContentItem>
        <TabContentItem>
            <Frame defaultPage="~/stories/stories-page" />
        </TabContentItem>
        <TabContentItem>
            <Frame defaultPage="~/videos/videos-page" />
        </TabContentItem>
        <TabContentItem>
            <Frame defaultPage="~/settings/settings-page" />
        </TabContentItem>
    </BottomNavigation>
</Page>