<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <ScrollView>
        <StackLayout class="p-4">
            <Label text="Little Explorer" class="title-text" />
            <Label text="Jouons à des jeux amusants !" class="subtitle-text" />
            
            <ListView items="{{ quizzes }}" height="80%" separatorColor="transparent" class="m-t-4">
                <ListView.itemTemplate>
                    <StackLayout class="card m-y-2 p-4" tap="{{ $parents['ListView'].onQuizTap }}">
                        <GridLayout columns="auto, *" rows="auto, auto">
                            <Image src="{{ icon }}" width="50" height="50" row="0" col="0" rowSpan="2" class="m-r-2" />
                            <Label text="{{ title }}" row="0" col="1" class="font-bold" />
                            <Label text="{{ description }}" row="1" col="1" textWrap="true" class="subtitle-text" />
                        </GridLayout>
                        <StackLayout orientation="horizontal" class="m-t-2">
                            <Label text="Niveau: " class="text-sm" />
                            <Label text="{{ level }}" class="text-sm font-bold" />
                            <Label text=" | " class="text-sm" />
                            <Label text="{{ questions.length }} questions" class="text-sm" />
                        </StackLayout>
                    </StackLayout>
                </ListView.itemTemplate>
            </ListView>
        </StackLayout>
    </ScrollView>
</Page>