<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <ActionBar class="nav-header">
        <NavigationButton text="Back" android.systemIcon="ic_menu_back" />
        <Label text="{{ quiz.title }}" />
        <ActionItem ios.position="right" android.position="actionBar">
            <Label text="{{ currentQuestionIndex + 1 }}/{{ quiz.questions.length }}" class="text-white p-r-2" />
        </ActionItem>
    </ActionBar>
    
    <GridLayout rows="*, auto">
        <ScrollView row="0">
            <StackLayout class="p-4">
                <!-- Question -->
                <Label text="{{ currentQuestion.text }}" textWrap="true" class="title-text" />
                
                <!-- Audio question type -->
                <StackLayout visibility="{{ currentQuestion.type === 'audio' ? 'visible' : 'collapsed' }}" class="m-y-4">
                    <Button text="🔊 Écouter" tap="{{ onPlayAudio }}" class="btn-primary" />
                    
                    <ListView items="{{ currentQuestion.options }}" visibility="{{ currentQuestion.options.length > 0 ? 'visible' : 'collapsed' }}" class="m-t-4">
                        <ListView.itemTemplate>
                            <StackLayout class="m-y-1">
                                <Button text="{{ $value }}" tap="{{ $parents['ListView'].onOptionSelected }}" class="btn-secondary" />
                            </StackLayout>
                        </ListView.itemTemplate>
                    </ListView>
                    
                    <TextField hint="Votre réponse..." text="{{ userAnswer }}" returnKeyType="done" class="m-t-4" visibility="{{ currentQuestion.options.length === 0 ? 'visible' : 'collapsed' }}" />
                </StackLayout>
                
                <!-- Text question type -->
                <StackLayout visibility="{{ currentQuestion.type === 'text' ? 'visible' : 'collapsed' }}" class="m-y-4">
                    <TextField hint="Votre réponse..." text="{{ userAnswer }}" returnKeyType="done" />
                </StackLayout>
                
                <!-- Speech question type -->
                <StackLayout visibility="{{ currentQuestion.type === 'speech' ? 'visible' : 'collapsed' }}" class="m-y-4">
                    <Button text="🎤 Parler" tap="{{ onStartSpeechRecognition }}" class="btn-primary" />
                    <Label text="{{ userAnswer }}" class="m-t-2 text-center" textWrap="true" />
                </StackLayout>
                
                <!-- Image question type -->
                <StackLayout visibility="{{ currentQuestion.type === 'image' ? 'visible' : 'collapsed' }}" class="m-y-4">
                    <GridLayout columns="*, *" rows="auto, auto">
                        <Image src="{{ '~/assets/images/quiz/' + currentQuestion.options[0] }}" tap="{{ onImageSelected }}" width="120" height="120" stretch="aspectFit" class="m-2" row="0" col="0" />
                        <Image src="{{ '~/assets/images/quiz/' + currentQuestion.options[1] }}" tap="{{ onImageSelected }}" width="120" height="120" stretch="aspectFit" class="m-2" row="0" col="1" />
                        <Image src="{{ '~/assets/images/quiz/' + currentQuestion.options[2] }}" tap="{{ onImageSelected }}" width="120" height="120" stretch="aspectFit" class="m-2" row="1" col="0" visibility="{{ currentQuestion.options.length > 2 ? 'visible' : 'collapsed' }}" />
                        <Image src="{{ '~/assets/images/quiz/' + currentQuestion.options[3] }}" tap="{{ onImageSelected }}" width="120" height="120" stretch="aspectFit" class="m-2" row="1" col="1" visibility="{{ currentQuestion.options.length > 3 ? 'visible' : 'collapsed' }}" />
                    </GridLayout>
                </StackLayout>
                
                <!-- Feedback -->
                <StackLayout visibility="{{ showFeedback ? 'visible' : 'collapsed' }}" class="m-t-4">
                    <Label text="{{ isCorrect ? '✅ Bravo!' : '❌ Réessaie!' }}" class="text-center font-bold" />
                    <Label text="{{ feedbackMessage }}" class="text-center" textWrap="true" />
                </StackLayout>
            </StackLayout>
        </ScrollView>
        
        <!-- Bottom buttons -->
        <GridLayout row="1" columns="*, *" class="p-4">
            <Button text="Vérifier" tap="{{ onCheck }}" class="btn-primary" col="0" visibility="{{ !showFeedback ? 'visible' : 'collapsed' }}" />
            <Button text="{{ isLastQuestion ? 'Terminer' : 'Suivant' }}" tap="{{ onNext }}" class="btn-primary" col="1" visibility="{{ showFeedback ? 'visible' : 'collapsed' }}" />
        </GridLayout>
    </GridLayout>
</Page>