<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <ScrollView>
        <StackLayout class="p-4">
            <Label text="Bonjour 👋" class="title-text" />
            <Label text="Découvrons de nouvelles choses !" class="subtitle-text" />
            
            <GridLayout columns="*, *" rows="auto, auto, auto, auto" horizontalAlignment="center" class="m-t-4">
                <!-- Unit 1 -->
                <StackLayout col="0" row="0" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit1">
                    <Image src="~/assets/images/units/family.png" height="100" stretch="aspectFit" />
                    <Label text="U1: Ma famille, mon amour!" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 2 -->
                <StackLayout col="1" row="0" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit2">
                    <Image src="~/assets/images/units/school.png" height="100" stretch="aspectFit" />
                    <Label text="U2: Mon école" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 3 -->
                <StackLayout col="0" row="1" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit3">
                    <Image src="~/assets/images/units/body.png" height="100" stretch="aspectFit" />
                    <Label text="U3: Mon corps" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 4 -->
                <StackLayout col="1" row="1" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit4">
                    <Image src="~/assets/images/units/food.png" height="100" stretch="aspectFit" />
                    <Label text="U4: Dans mon assiette!" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 5 -->
                <StackLayout col="0" row="2" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit5">
                    <Image src="~/assets/images/units/animals.png" height="100" stretch="aspectFit" />
                    <Label text="U5: Mes amis, les animaux" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 6 -->
                <StackLayout col="1" row="2" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit6">
                    <Image src="~/assets/images/units/book.png" height="100" stretch="aspectFit" />
                    <Label text="U6: Mon ami, le livre!" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 7 -->
                <StackLayout col="0" row="3" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit7">
                    <Image src="~/assets/images/units/games.png" height="100" stretch="aspectFit" />
                    <Label text="U7: Mes jeux préférés!" textWrap="true" class="text-center font-bold" />
                </StackLayout>
                
                <!-- Unit 8 -->
                <StackLayout col="1" row="3" class="card m-2 p-4" tap="{{ onUnitTap }}" id="unit8">
                    <Image src="~/assets/images/units/party.png" height="100" stretch="aspectFit" />
                    <Label text="U8: Quelle fête!" textWrap="true" class="text-center font-bold" />
                </StackLayout>
            </GridLayout>
        </StackLayout>
    </ScrollView>
</Page>