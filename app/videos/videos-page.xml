<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <ScrollView>
        <StackLayout class="p-4">
            <Label text="Vidéos" class="title-text" />
            <Label text="Regardez et apprenez!" class="subtitle-text" />
            
            <ListView items="{{ videos }}" height="90%" separatorColor="transparent" class="m-t-4">
                <ListView.itemTemplate>
                    <StackLayout class="card m-y-2" tap="{{ $parents['ListView'].onVideoTap }}">
                        <!-- Video thumbnail with play button overlay -->
                        <GridLayout>
                            <Image src="{{ thumbnail }}" stretch="aspectFill" height="180" />
                            <Image src="~/assets/images/videos/play_button.png" width="50" height="50" />
                        </GridLayout>
                        
                        <!-- Video info -->
                        <StackLayout class="p-3">
                            <Label text="{{ title }}" class="font-bold" />
                            <Label text="{{ description }}" textWrap="true" class="subtitle-text" />
                            <StackLayout orientation="horizontal" class="m-t-2">
                                <Label text="{{ duration }}" class="text-sm" />
                                <Label text=" | " class="text-sm" />
                                <Label text="{{ hasSubtitles ? 'Sous-titres disponibles' : '' }}" class="text-sm" />
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </ListView.itemTemplate>
            </ListView>
        </StackLayout>
    </ScrollView>
</Page>