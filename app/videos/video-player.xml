<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page" actionBarHidden="true">
    <GridLayout rows="auto, *, auto">
        <!-- Custom header -->
        <GridLayout row="0" columns="auto, *, auto" class="p-2 bg-black">
            <Button text="←" tap="{{ onBackToVideos }}" class="text-white font-bold" col="0" />
            <Label text="{{ video.title }}" class="text-white text-center" col="1" />
            <Button text="{{ isFullscreen ? '◱' : '⛶' }}" tap="{{ onToggleFullscreen }}" class="text-white font-bold" col="2" />
        </GridLayout>
        
        <!-- Video player -->
        <GridLayout row="1" height="{{ isFullscreen ? '100%' : '300' }}">
            <!-- Video player would be here in a real implementation -->
            <Image src="{{ video.thumbnail }}" stretch="aspectFill" />
            
            <!-- Play/pause overlay -->
            <GridLayout visibility="{{ showControls ? 'visible' : 'collapsed' }}" tap="{{ onTogglePlayPause }}">
                <StackLayout horizontalAlignment="center" verticalAlignment="center">
                    <Label text="{{ isPlaying ? '⏸️' : '▶️' }}" class="text-white text-5xl" />
                </StackLayout>
            </GridLayout>
            
            <!-- Video controls -->
            <GridLayout rows="auto" verticalAlignment="bottom" class="p-2" visibility="{{ showControls ? 'visible' : 'collapsed' }}">
                <StackLayout>
                    <!-- Progress bar -->
                    <GridLayout columns="auto, *, auto" class="m-b-2">
                        <Label text="{{ currentTime }}" class="text-white text-sm" col="0" />
                        <Progress value="{{ progress }}" maxValue="100" class="m-x-2" col="1" />
                        <Label text="{{ video.duration }}" class="text-white text-sm" col="2" />
                    </GridLayout>
                    
                    <!-- Control buttons -->
                    <GridLayout columns="auto, auto, auto, auto, auto" class="text-white">
                        <Button text="⏮️" tap="{{ onRewind }}" class="text-white" col="0" />
                        <Button text="{{ isPlaying ? '⏸️' : '▶️' }}" tap="{{ onTogglePlayPause }}" class="text-white" col="1" />
                        <Button text="⏭️" tap="{{ onForward }}" class="text-white" col="2" />
                        <Button text="{{ isMuted ? '🔇' : '🔊' }}" tap="{{ onToggleMute }}" class="text-white" col="3" />
                        <Button text="{{ showSubtitles ? 'CC' : 'cc' }}" tap="{{ onToggleSubtitles }}" class="text-white" col="4" />
                    </GridLayout>
                </StackLayout>
            </GridLayout>
            
            <!-- Subtitles -->
            <Label text="{{ currentSubtitle }}" class="text-white text-center p-2 bg-black" opacity="0.7" verticalAlignment="bottom" visibility="{{ showSubtitles ? 'visible' : 'collapsed' }}" />
            
            <!-- Interactive questions -->
            <GridLayout visibility="{{ showQuestion ? 'visible' : 'collapsed' }}" class="bg-black" opacity="0.9">
                <StackLayout class="p-4">
                    <Label text="{{ currentQuestion.text }}" class="text-white text-center font-bold m-b-4" textWrap="true" />
                    
                    <StackLayout class="m-b-4">
                        <Button text="{{ currentQuestion.options[0] }}" tap="{{ onAnswerSelected }}" class="btn-secondary m-y-1" id="option0" />
                        <Button text="{{ currentQuestion.options[1] }}" tap="{{ onAnswerSelected }}" class="btn-secondary m-y-1" id="option1" />
                        <Button text="{{ currentQuestion.options[2] }}" tap="{{ onAnswerSelected }}" class="btn-secondary m-y-1" id="option2" visibility="{{ currentQuestion.options.length > 2 ? 'visible' : 'collapsed' }}" />
                    </StackLayout>
                    
                    <Button text="Continuer la vidéo" tap="{{ onCloseQuestion }}" class="btn-primary" />
                </StackLayout>
            </GridLayout>
        </GridLayout>
        
        <!-- Interactive question area (below player in non-fullscreen mode) -->
        <StackLayout row="2" class="p-4" visibility="{{ !isFullscreen && showRecentQuestion ? 'visible' : 'collapsed' }}">
            <Label text="Que fait l'enfant dans cette scène ?" class="font-bold" textWrap="true" />
            
            <StackLayout class="m-t-2">
                <Button text="Il joue avec un ballon" class="btn-secondary m-y-1" />
                <Button text="Il dessine" class="btn-secondary m-y-1" />
                <Button text="Il mange une pomme" class="btn-secondary m-y-1" />
            </StackLayout>
        </StackLayout>
    </GridLayout>
</Page>